# ---- Server ----
PORT=4000
CORS_ORIGIN=*

# ---- Database (Neon, pooled) ----
# Use your Neon pooler URL, keep sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# ---- AI meal engine ----
ANTHROPIC_API_KEY=sk-ant-xxxx
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Auth seam (dev only) ----
# When set, requests without an x-user-id header are attributed to this id.
# Leave blank in production and enforce your real JWT/2FA middleware instead.
DEV_USER_ID=
